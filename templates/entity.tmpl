{{ define "title" }}{{ .Entity.Label }} - {{ .Locale.T "app.title" }}{{ end }}

{{ define "content" }}
{{ template "site_header" (dict "Locale" .Locale "Back" true) }}

<div class="row">
	<div class="col">
		<h2 class="text-{{ .Entity.StatusClass }}">{{ .Entity.Label }}</h2>
		<p>
			<span class="badge text-bg-secondary">{{ .Entity.Group }}</span>
			<span class="badge text-bg-{{ .Entity.StatusClass }}">{{ .Entity.StatusText }}</span>
		</p>
		{{ template "history_bar" .Entity.History }}
	</div>
</div>

{{ if .Entity.HasAvailability }}
<div class="row mt-4">
	<div class="col">
		<h2>{{ .Locale.T "section.availability" }}</h2>
		<table class="table table-sm w-auto">
			<thead>
				<tr>
					<th scope="col">{{ .Locale.T "table.period" }}</th>
					{{ if .Entity.ShowReportedAvailability }}
					<th scope="col" class="text-end">{{ .Locale.T "table.reported" }}</th>
					{{ end }}
					<th scope="col" class="text-end">{{ .Locale.T "table.probe" }}</th>
				</tr>
			</thead>
			<tbody>
				{{ range $stat := .Entity.Availability }}
				<tr>
					<td>{{ $stat.Label }}</td>
					{{ if $.Entity.ShowReportedAvailability }}
					<td class="text-end{{ if not $stat.ReportedAvailable }} text-muted{{ end }}">{{ $stat.Reported }}</td>
					{{ end }}
					<td class="text-end{{ if not $stat.ProbeAvailable }} text-muted{{ end }}">{{ $stat.Probe }}</td>
				</tr>
				{{ end }}
			</tbody>
		</table>
	</div>
</div>
{{ end }}

<div class="row mt-4">
	<div class="col">
		<h2>{{ .Locale.T "section.probe_log" }}</h2>
		{{ if .Entity.HasEvents }}
		<table class="table table-sm stacked-table" role="table">
			<thead role="rowgroup">
				<tr role="row">
					<th scope="col" role="columnheader">{{ .Locale.T "table.time" }}</th>
					{{ if .Entity.ShowEventEntity }}
					<th scope="col" role="columnheader">{{ .Locale.T "table.entity" }}</th>
					{{ end }}
					<th scope="col" role="columnheader">{{ .Locale.T "table.method" }}</th>
					<th scope="col" role="columnheader">{{ .Locale.T "table.status" }}</th>
					<th scope="col" role="columnheader">{{ .Locale.T "table.message" }}</th>
					<th scope="col" role="columnheader">{{ .Locale.T "table.covered_by" }}</th>
				</tr>
			</thead>
			<tbody role="rowgroup">
				{{ range $event := .Entity.Events }}
				<tr role="row" class="table-{{ $event.StatusClass }}{{ if $event.HasCoverage }} probe-covered probe-covered-{{ $event.CoveredBy.Class }}{{ if $event.GroupStart }} probe-covered-start{{ end }}{{ if $event.GroupEnd }} probe-covered-end{{ end }}{{ end }}">
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.time" }}</span><div class="cell-value">{{ $event.ChangedAt }}</div></td>
					{{ if $.Entity.ShowEventEntity }}
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.entity" }}</span><div class="cell-value">{{ $event.Entity }}</div></td>
					{{ end }}
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.method" }}</span><div class="cell-value">{{ $event.Method }}</div></td>
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.status" }}</span><div class="cell-value">{{ $event.Status }}</div></td>
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.message" }}</span><div class="cell-value">{{ $event.Message }}</div></td>
					<td role="cell"><span class="cell-label" aria-hidden="true">{{ $.Locale.T "table.covered_by" }}</span><div class="cell-value">
						{{ if $event.HasCoverage }}
							{{ if $event.CoveredBy.URL }}
							<a class="badge text-bg-{{ $event.CoveredBy.Class }} text-decoration-none" href="{{ $event.CoveredBy.URL }}" target="_blank" rel="noopener">{{ $event.CoveredBy.Label }}</a>
							{{ else }}
							<span class="badge text-bg-{{ $event.CoveredBy.Class }}">{{ $event.CoveredBy.Label }}</span>
							{{ end }}
						{{ else }}
						<span class="text-muted">-</span>
						{{ end }}
					</div></td>
				</tr>
				{{ end }}
			</tbody>
		</table>
		{{ with .Entity.EventPagination }}
		{{ if .HasPages }}
		<nav aria-label="{{ $.Locale.T "probe_log.pages" }}">
			<ul class="pagination pagination-sm">
				<li class="page-item{{ if not .HasPrevious }} disabled{{ end }}">
					{{ if .HasPrevious }}
					<a class="page-link" href="{{ .PreviousURL }}">{{ $.Locale.T "probe_log.previous" }}</a>
					{{ else }}
					<span class="page-link">{{ $.Locale.T "probe_log.previous" }}</span>
					{{ end }}
				</li>
				{{ range $link := .Links }}
				<li class="page-item{{ if $link.Current }} active{{ end }}{{ if $link.Disabled }} disabled{{ end }}">
					{{ if $link.Disabled }}
					<span class="page-link">{{ $link.Label }}</span>
					{{ else if $link.Current }}
					<span class="page-link" aria-current="page">{{ $link.Label }}</span>
					{{ else }}
					<a class="page-link" href="{{ $link.URL }}">{{ $link.Label }}</a>
					{{ end }}
				</li>
				{{ end }}
				<li class="page-item{{ if not .HasNext }} disabled{{ end }}">
					{{ if .HasNext }}
					<a class="page-link" href="{{ .NextURL }}">{{ $.Locale.T "probe_log.next" }}</a>
					{{ else }}
					<span class="page-link">{{ $.Locale.T "probe_log.next" }}</span>
					{{ end }}
				</li>
			</ul>
		</nav>
		{{ end }}
		{{ end }}
		{{ else }}
		<div class="alert alert-secondary">{{ .Locale.T "probe_log.no_changes" }}</div>
		{{ end }}
	</div>
</div>
{{ end }}
